# Salin file ini jadi ".env" lalu isi nilainya sebelum menjalankan dashboard.

# --- Insightly (sumber data Leads, SAMA dengan yang dipakai bot WhatsApp) ---
# API Key dari akun Insightly Anda: Settings (ikon gerigi) > API > API Key.
INSIGHTLY_API_KEY=
# "Pod" server Insightly akun Anda (mis. "na1", "eu1", "ap1", "au1") -- lihat
# penjelasan lengkap di README bot WhatsApp, bagian Insightly.
INSIGHTLY_POD=
# Opsional -- HARUS SAMA dengan nilai di .env bot WhatsApp kalau diisi di
# sana. Default 3832232 (ID picklist Lead Source "Chatbots" di akun
# Insightly ONEderland saat ini).
INSIGHTLY_CHATBOT_LEAD_SOURCE_ID=3832232
# Opsional -- HARUS SAMA dengan nilai di .env bot WhatsApp kalau diisi di
# sana. Default "wachatbot". Dashboard memfilter leads berdasarkan tag ini
# (BUKAN cuma Lead Source di atas -- Lead Source "Chatbots" ternyata dipakai
# BERSAMA chatbot lain di website ONEderland, jadi tag ini satu-satunya
# penanda yang benar-benar unik untuk leads dari bot WhatsApp).
INSIGHTLY_LEAD_TAG=wachatbot

# --- Database (untuk menyimpan Meeting Summary & LOA, TIDAK untuk data Lead
# itu sendiri -- Lead selalu diambil langsung dari Insightly) ---
# Connection string Postgres dari project Supabase "HRM" (sudah disiapkan,
# tabelnya ada di schema TERPISAH `oneland_dashboard`, tidak campur dengan
# data HRM). Ambil dari: Supabase dashboard > pilih project "HRM" > Project
# Settings (ikon gerigi) > Database > Connection string > tab "URI" (mode
# "Session", BUKAN "Transaction") -- copy lalu ganti [YOUR-PASSWORD] dengan
# password database project itu.
DATABASE_URL=

# --- Login dashboard (versi pertama: 1 password bersama untuk semua konsultan) ---
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=ganti-ini-dengan-password-yang-kuat

# Kunci rahasia untuk enkripsi session login -- isi string acak panjang apa
# saja (mis. hasil dari: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=

# Port server (platform hosting seperti Render biasanya mengisi otomatis lewat
# env PORT -- nilai ini cuma dipakai kalau PORT tidak ada, mis. saat jalan di
# komputer sendiri)
PORT=3100

# Nama bisnis, dipakai di judul halaman
BUSINESS_NAME=ONEderland Consulting
